# Client environment — copy to .env.local and fill in.
# Variable names follow the wiring contract in TASK.md.

# Backend base URL. Leave unset until backend/API is built: the client falls
# back to its in-repo mock transport and every hook stays functional.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional overrides.
# NEXT_PUBLIC_API_TIMEOUT_MS=15000
# NEXT_PUBLIC_MOCK_LATENCY_MS=320
